{
  "source_url": "https://iptv-org.github.io/iptv/index.m3u",
  "favorites": [
    {
      "label": "ESPN (todas las variantes disponibles)",
      "patterns": [
        "^ESPN(?:\\b|[0-9+])"
      ],
      "group": "Deportes - ESPN",
      "exclude_countries": [
        "nl",
        "br"
      ],
      "exclude_patterns": [
        "\\b(?:Netherlands|Nederland|Brazil|Brasil)\\b",
        "\\b(?:NL|BR)\\b"
      ]
    },
    {
      "label": "América TV (Perú)",
      "patterns": [
        "^Am[eé]rica\\s*(?:TV|Televisi[oó]n)(?:\\b|$)"
      ],
      "countries": [
        "pe"
      ],
      "group": "Perú"
    },
    {
      "label": "ATV (Perú)",
      "patterns": [
        "^ATV(?:\\b|\\s|$)",
        "^Andina de Televisi[oó]n\\b"
      ],
      "countries": [
        "pe"
      ],
      "group": "Perú"
    },
    {
      "label": "CBS Boston",
      "patterns": [
        "CBS\\s*(?:News\\s*)?Boston",
        "^WBZ(?:-TV)?(?:\\b|\\s)"
      ],
      "group": "Estados Unidos - Boston"
    }
  ]
}
